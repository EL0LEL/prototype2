# ==============================================================
# SAKELAR MODE APLIKASI (DUAL-MODE)
# Pilihan:
# "OFFLINE"     : Operasional toko fisik (SQLite lokal tablet, Wi-Fi Direct, 100% tanpa internet)
# "ONLINE_DEMO" : Mode presentasi/demo jarak jauh (terhubung ke REST API online)
# ==============================================================
VITE_APP_MODE="OFFLINE"

# 1. IDENTITAS & METADATA TOKO
VITE_APP_NAME="iPOS 5 Standard UMKM"
VITE_APP_VERSION="1.0.0"
VITE_STORE_NAME="TOKO RINA 2"
VITE_STORE_ADDRESS="Jl. Raya Pasar Tradisional No. 12"
VITE_STORE_PHONE="0812-3456-7890"
VITE_STORE_FOOTER="Terima kasih atas kunjungan Anda. Barang yang sudah dibeli tidak dapat ditukar/dikembalikan."

# 2. AKUN DEFAULT SUPERUSER (PERTAMA KALI PASANG)
VITE_DEFAULT_ADMIN_USER="admin"
VITE_DEFAULT_ADMIN_PASS="admin"

# 3. KONFIGURASI JARINGAN LOKAL (MODE OFFLINE DI TOKO)
VITE_LOCAL_SYNC_PORT=8080
VITE_LOCAL_DB_NAME="pos_toko_offline.db"

# 4. KONFIGURASI BACKEND & DEMO ONLINE
PORT=5000
VITE_ONLINE_API_URL="http://localhost:5000/api"
